# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Supabase: Project Settings > API Keys and Data API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security. Used by the seed script and the outbox API.
SUPABASE_SECRET_KEY=
# Used only on your machine to run migrations: Connect > Session pooler
SUPABASE_DB_URL=

# The model that reads report text. Any OpenAI-compatible endpoint works.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# Tried in order if the first model fails or is rate limited. Comma separated.
LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free
LLM_API_KEY=

# Shared secret that n8n sends when it collects outbox events. Any long random string.
OUTBOX_SECRET=
