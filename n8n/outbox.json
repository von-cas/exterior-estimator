{
  "name": "Exterior estimator: outbox",
  "nodes": [
    {
      "id": "a1",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "a2",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "appUrl",
              "value": "https://YOUR-APP.vercel.app",
              "type": "string"
            },
            {
              "id": "s2",
              "name": "orderEmailTo",
              "value": "you@example.com",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a3",
      "name": "Claim events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').item.json.appUrl }}/api/outbox/claim?limit=10",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "a4",
      "name": "One item per event",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        300
      ],
      "parameters": {
        "fieldToSplitOut": "events",
        "options": {}
      }
    },
    {
      "id": "a5",
      "name": "Purchase order?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.event_type }}",
              "rightValue": "purchase_order.approved",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a6",
      "name": "Email purchase order",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: 'Estimator demo <onboarding@resend.dev>', to: [$('Settings').item.json.orderEmailTo], subject: 'Purchase order ' + $json.payload.key.slice(-12) + ' for ' + $json.payload.supplier, html: (() => {\n  const p = $json.payload;\n  const usd = (c) => '$' + (c / 100).toFixed(2);\n  const rows = p.lines.map(l => `<tr><td>${l.sku}</td><td>${l.productName}</td><td align=\"right\">${l.quantity} ${l.unit}</td><td align=\"right\">${usd(l.unitCost)}</td><td align=\"right\">${usd(l.cost)}</td></tr>`).join('');\n  return `<p>Purchase order for job <b>${p.job}</b>.</p><p>Order key: <code>${p.key}</code>. If this key was already received, ignore this copy.</p>\n<table border=\"1\" cellpadding=\"4\" cellspacing=\"0\"><tr><th>SKU</th><th>Item</th><th>Qty</th><th>Unit cost</th><th>Cost</th></tr>${rows}\n<tr><td colspan=\"4\" align=\"right\"><b>Total</b></td><td align=\"right\"><b>${usd(p.total_cost)}</b></td></tr></table>\n<p>Demo order. Prices are made up.</p>`;\n})() }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "a7",
      "name": "Acknowledge sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').item.json.appUrl }}/api/outbox/ack",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $('Purchase order?').item.json.id, ok: true }) }}",
        "options": {}
      }
    },
    {
      "id": "a8",
      "name": "Acknowledge failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').item.json.appUrl }}/api/outbox/ack",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $('Purchase order?').item.json.id, ok: false, error: String($json.error?.message ?? $json.error ?? 'email failed').slice(0, 500) }) }}",
        "options": {}
      }
    },
    {
      "id": "a9",
      "name": "Gave up?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "g1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "failed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a10",
      "name": "Alert: order not sent",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1760,
        280
      ],
      "parameters": {
        "errorMessage": "=Purchase order {{ $('Purchase order?').item.json.payload.key }} for {{ $('Purchase order?').item.json.payload.supplier }} could not be sent after 5 attempts"
      }
    },
    {
      "id": "a11",
      "name": "Acknowledge (no CRM in demo)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        420
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').item.json.appUrl }}/api/outbox/ack",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $json.id, ok: true }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Settings": {
      "main": [
        [
          {
            "node": "Claim events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim events": {
      "main": [
        [
          {
            "node": "One item per event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per event": {
      "main": [
        [
          {
            "node": "Purchase order?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email purchase order": {
      "main": [
        [
          {
            "node": "Acknowledge sent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Acknowledge failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Acknowledge failure": {
      "main": [
        [
          {
            "node": "Gave up?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gave up?": {
      "main": [
        [
          {
            "node": "Alert: order not sent",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Purchase order?": {
      "main": [
        [
          {
            "node": "Email purchase order",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Acknowledge (no CRM in demo)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "all"
  }
}